# Environment Configuration
# Copy this file to .env and update with your values
# DO NOT commit .env to version control

# Backend API URLs
#
# Local development:
#   Android emulator → http://10.0.2.2:8080
#   Physical device / iOS → your machine's LAN IP (e.g. http://192.168.1.x:8080)
#
# Production (deployed API):
#   https://api.momlaunchpad.com
#   Use these values in the GitHub Actions `ENV_FILE` secret for CI and release builds.

API_BASE_URL=http://10.0.2.2:8080
WS_BASE_URL=ws://10.0.2.2:8080

# Google OAuth Web client ID (same value as android/.../strings.xml default_web_client_id)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# GA4 / Firebase Analytics (off in debug unless true)
# FIREBASE_ANALYTICS_ENABLED=true

# Production example (paste into GitHub secret `ENV_FILE`):
# API_BASE_URL=https://api.momlaunchpad.com
# WS_BASE_URL=wss://api.momlaunchpad.com
# GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
