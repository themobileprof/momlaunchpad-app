#!/usr/bin/env bash
# Runs before each `git commit`. Skip with: git commit --no-verify
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "pre-commit: flutter test"
flutter test

